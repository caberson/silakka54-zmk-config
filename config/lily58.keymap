#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: hmL {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            display-name = "hm";
            hold-trigger-on-release;
            hold-trigger-key-positions = <52 51 50 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57>;
            hold-while-undecided;
        };

        ltb: ltBal {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;

            display-name = "lt_bal";
            hold-while-undecided;
        };

        mBsDel: morphBackspaceDel {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_LGUI)>;
        };

        tdMinusUnd: tdMinusUnd {
            compatible = "zmk,behavior-tap-dance";
            label = "TDMINUSUND";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;
        };

        tdEqPlus: tdEqPlus {
            compatible = "zmk,behavior-tap-dance";
            label = "TDEQPLUS";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp EQUAL>, <&kp PLUS>;
        };

        tdLBrkBrc: tdLBrkBrc {
            compatible = "zmk,behavior-tap-dance";
            label = "TDLBRKBRC";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;
        };

        tdRBrkBrc: tdRBrkBrc {
            compatible = "zmk,behavior-tap-dance";
            label = "TDRBRKBRC";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;
        };

        tdGrvTil: tdGrvTil {
            compatible = "zmk,behavior-tap-dance";
            label = "TDGRVTIL";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
        };

        tdBslhPip: tdBslhPip {
            compatible = "zmk,behavior-tap-dance";
            label = "TDBSLHPIP";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp BACKSLASH>, <&kp PIPE>;
        };

        tdSqDq: tdSqDq {
            compatible = "zmk,behavior-tap-dance";
            label = "TDSQDQ";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        hmr: hmR {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            display-name = "hm";
            hold-trigger-on-release;
            hold-trigger-key-positions = <52 51 50 55 56 57 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            label = "HMR";
            hold-while-undecided;
        };

        htRepeat: htRepeat {
            compatible = "zmk,behavior-hold-tap";
            label = "HTREPEAT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
        };

        tdBsDel: tdBsDel {
            compatible = "zmk,behavior-tap-dance";
            label = "TDBSDEL";
            #binding-cells = <0>;
            bindings =
                <&htRepeat BACKSPACE BACKSPACE>,
                <&htRepeat DELETE DELETE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cMinusUnd {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
        };

        cEqPlus {
            bindings = <&kp EQUAL>;
            key-positions = <21 20>;
            layers = <0>;
        };

        cSystL {
            bindings = <&mo 3>;
            key-positions = <52 40>;
            layers = <0>;
        };

        cSystR {
            bindings = <&mo 3>;
            key-positions = <55 45>;
            layers = <0>;
        };

        cLftBrkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <45 46>;
            layers = <0>;
        };

        cRBrkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <46 47>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BSPC |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | CTRL  |GUI/A|ALT/S|CTL/D |  F   |  G   |                   |  H   |  J    |CTL/K  |ALT/L |GUI/; |  '/"  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  |L1/TAB| SPACE|  n/a   |  |  n/a  |L2/RET| BSPC  | ALT   |
            // Note: Home row mods - A/S/D = GUI/Alt/Ctrl (left), K/L/; = Ctrl/Alt/GUI (right)
            // Dedicated Ctrl on left corner for instant terminal commands

            display-name = "Base";
            bindings = <
&kp ESCAPE       &kp N1       &kp N2       &kp N3    &kp N4         &kp N5                               &kp N6                &kp N7               &kp N8     &kp N9       &kp N0          &kp BACKSPACE
&kp TAB          &kp Q        &kp W        &kp E     &kp R          &kp T                                &kp Y                 &kp U                &kp I      &kp O        &kp P           &kp BACKSLASH
&mt LCTRL GRAVE  &hml LGUI A  &hml LALT S  &ltb 1 D  &hml LCTRL F   &kp G                                &kp H                 &hmr LEFT_CONTROL J  &ltb 1 K   &hmr RALT L  &hmr RGUI SEMI  &kp SINGLE_QUOTE
&kp LSHFT        &kp Z        &kp X        &kp C     &kp V          &kp B                &none    &none  &kp N                 &kp M                &kp COMMA  &kp PERIOD   &kp FSLH        &kp RSHFT
                                           &mo 2     &ltb 1 ESCAPE  &hml LEFT_GUI SPACE  &none    &none  &hmr LEFT_GUI RETURN  &ltb 1 BACKSPACE     &mo 1
            >;
        };

        symb {
            // ------------------------------------------------------------------------------------------------------------
            // | trans | trans|trans| trans| trans| trans|                   | trans| trans | trans | trans| trans | trans |
            // | trans |  !   |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   | trans |
            // | trans |  1   |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  \|   |
            // | trans |  6   |  7  |  8   |  9   |  0   |  n/a   |  |  n/a  |  `~  |  -_   |  =+   |  [{  |   ]}  | trans |
            //                     | trans| trans| trans|  n/a   |  |  n/a  | trans| trans | trans |
            // Tap-dances: `~ = tap for `, double-tap for ~; -_ = tap -, double-tap _; etc.

            display-name = "symb";
            bindings = <
&trans  &trans          &trans          &trans        &trans                 &trans                             &trans        &trans          &trans        &trans          &trans           &trans
&trans  &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4           &kp N5                             &kp NUMBER_6  &kp N7          &kp N8        &kp N9          &kp N0           &trans
&trans  &kp LEFT_SHIFT  &sk LEFT_SHIFT  &kp DELETE    &hml LEFT_CONTROL TAB  &kp BACKSPACE                      &kp LEFT      &kp DOWN        &kp UP_ARROW  &kp RIGHT       &kp RIGHT_SHIFT  &trans
&trans  &kp BACKSLASH   &kp MINUS       &kp EQUAL     &kp LEFT_BRACKET       &kp RIGHT_BRACKET  &none    &none  &kp PIPE      &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
                                        &trans        &trans                 &trans             &none    &none  &trans        &trans          &trans
            >;
        };

        func {
            display-name = "func";
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                   &trans            &trans          &trans         &trans         &trans    &trans
&trans  &trans  &trans  &trans   &trans   &trans                   &none             &kp C_BRI_DEC   &kp C_BRI_INC  &none          &trans    &trans
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                   &kp C_MUTE        &kp C_VOL_DN    &kp C_VOL_UP   &kp PG_UP      &kp HOME  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &none    &none  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT     &kp PAGE_DOWN  &kp END   &trans
                        &trans   &trans   &trans   &none    &none  &trans            &trans          &trans
            >;
        };

        syst {
            display-name = "syst";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans            &trans          &trans         &trans         &trans  &trans
&trans      &trans        &trans        &trans        &out OUT_USB  &out OUT_BLE                  &none             &kp C_BRI_DEC   &kp C_BRI_INC  &none          &trans  &trans
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                        &kp C_MUTE        &kp C_VOL_DN    &kp C_VOL_UP   &kp PG_UP      &trans  &trans
&kp F7      &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &none    &none  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT     &kp PAGE_DOWN  &trans  &trans
                                        &trans        &trans        &trans        &none    &none  &trans            &trans          &trans
            >;
        };

        misc_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT0  | BT1 | BT2  | BT3  | BT4  |                   | USB  | BLE   | trans | trans| trans |BT_CLR_A|
            // | trans | trans|trans| trans| trans| trans|                   | trans| trans | trans | trans| trans | trans |
            // | trans | trans|trans| trans| trans| trans|                   | trans| HOME  | PG_DN | PG_UP| END   | trans |
            // | trans | trans|trans| trans| trans| trans|  n/a   |  |  n/a  | trans| trans | trans | trans| trans | trans |
            //                     | trans| trans| trans|  n/a   |  |  n/a  | trans| trans | trans |
            // Note: Access via hold Enter - Bluetooth controls, USB/BLE switching, navigation keys

            display-name = "misc";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &out OUT_USB  &out OUT_BLE  &trans         &trans       &trans     &bt BT_CLR_ALL
&trans      &trans        &trans        &trans        &trans        &trans                        &trans        &trans        &trans         &trans       &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans                        &trans        &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &none    &none  &trans        &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
                                        &trans        &trans        &trans        &none    &none  &trans        &trans        &trans
            >;
        };

        extra_2 { status = "reserved"; };
    };
};
